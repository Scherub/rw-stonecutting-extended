<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>StonecuttingExtended</RootNamespace>
	<AssemblyName>StonecuttingExtended</AssemblyName>
	<ModDirectory>$(SolutionDir)..\1.5\Assemblies\</ModDirectory>
  </PropertyGroup>

	<!-- Source files are shared with the v1.4 project. Exclude a file here and add a version-specific copy to this project if it needs to diverge. -->
	<ItemGroup>
		<Compile Include="..\StonecuttingExtended 1.4\Source\**\*.cs" Link="Source\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.5.4409" />
  </ItemGroup>

  <Target Name="CopyAssemblyToModDirectory" AfterTargets="Build">
	<Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModDirectory)" />
	<Message Importance="high" Text="Copied '$(TargetFileName)' to '$(ModDirectory).'" />
  </Target>

</Project>
